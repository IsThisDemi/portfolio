---
import { Image } from 'astro:assets';
import { education, sections } from '@/data/cv';
import { formatPeriod } from '@/lib/format';
import Icon from '@/components/Icon.astro';
import Window from '@/components/Window.astro';

const section = sections.find((s) => s.id === 'education')!;
---

<Window id="education" title={section.title} icon={section.icon} tint={section.tint}>
  <ul class="diplomas">
    {
      education.map((diploma) => (
        <li class="diploma">
          <span class="tile diploma-logo">
            <Image src={diploma.logo} alt="" width={104} height={104} />
          </span>
          <div class="diploma-text">
            <h3>{diploma.title}</h3>
            <p class="institution">{diploma.institution}</p>
            <p class="description">{diploma.description}</p>
            <p class="diploma-meta">
              <span class="period">{formatPeriod(diploma.period)}</span>
              {diploma.result && <span class="result">{diploma.result}</span>}
            </p>
          </div>
          <a
            class="glass glass-button icon-only diploma-link"
            href={diploma.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${diploma.institution} website`}
            title="Website"
          >
            <Icon name="fa6-solid:arrow-up-right-from-square" />
          </a>
        </li>
      ))
    }
  </ul>
</Window>

<style>
  .diplomas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .diploma {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    border-radius: 20px;
    background: var(--group-bg);
    box-shadow: inset 0 0 0 0.5px var(--sep);
  }

  .diploma-logo {
    --tile: 52px;
  }

  .diploma-text {
    flex: 1;
    min-width: 0;
  }

  h3 {
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .institution {
    margin-top: 2px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent);
  }

  .description {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--text-2);
  }

  .diploma-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .period,
  .result {
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    background: var(--fill-2);
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .result {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
  }

  .diploma-link {
    flex: none;
    width: 30px;
    height: 30px;
  }

  .diploma-link :global(svg) {
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .diplomas {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
