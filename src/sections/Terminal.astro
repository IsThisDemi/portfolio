---
import { profile, skills } from '@/data/cv';
import { tech } from '@/data/tech';
import Window from '@/components/Window.astro';

const stack = skills[0]!.items.map((key) => tech[key].name);

// Lines appear one after another, like output scrolling in.
let delay = 500;
const next = (step = 140) => {
  const value = delay;
  delay += step;
  return `animation-delay:${value}ms`;
};
---

<Window id="terminal" title="riccardo — zsh — 80×24" variant="terminal" class="terminal-window">
  <div class="terminal" role="log" aria-label="Terminal session">
    <p class="line faint" style={next(200)}>Last login: today on ttys001</p>

    <p class="line" style={next()}><span class="prompt">riccardo@macbook ~ %</span> whoami</p>
    <p class="line out strong" style={next()}>{profile.name}</p>

    <p class="line" style={next()}><span class="prompt">riccardo@macbook ~ %</span> cat role.txt</p>
    <p class="line out" style={next()}>{profile.role} | {profile.subtitle}</p>

    <p class="line" style={next()}><span class="prompt">riccardo@macbook ~ %</span> cat about.md</p>
    <p class="line out about" style={next(220)}>{profile.about}</p>

    <p class="line" style={next()}><span class="prompt">riccardo@macbook ~ %</span> ls ~/stack</p>
    <p class="line out stack" style={next()}>
      {stack.map((name) => <span>{name}</span>)}
    </p>

    <p class="line" style={next()}><span class="prompt">riccardo@macbook ~ %</span> cat status.json</p>
    <p class="line out" style={next()}>
      {'{ '}<span class="key">"available"</span>: <span class="value">true</span>, <span class="key">"relocation"</span
      >: <span class="value">true</span>{' }'}
    </p>

    <p class="line" style={next()}>
      <span class="prompt">riccardo@macbook ~ %</span>
      <span class="cursor" aria-hidden="true"></span>
    </p>
  </div>
</Window>

<style>
  .terminal {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    color: #e6e6ea;
  }

  .line {
    animation: line-in 0.3s ease both;
    overflow-wrap: anywhere;
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }

  .line + .line:has(.prompt) {
    margin-top: 10px;
  }

  .prompt {
    color: #5ee08a;
    font-weight: 600;
  }

  .out {
    color: #c9c9d1;
  }

  .strong {
    color: #fff;
    font-weight: 700;
  }

  .faint {
    color: rgb(255 255 255 / 0.4);
  }

  .about {
    max-width: 68ch;
    color: #b8b8c2;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    color: #7cc4ff;
  }

  .key {
    color: #ff9ec7;
  }

  .value {
    color: #ffd479;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.15em;
    vertical-align: text-bottom;
    background: #e6e6ea;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .terminal {
      font-size: 12px;
    }
  }
</style>
