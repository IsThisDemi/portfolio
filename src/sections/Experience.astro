---
import { Image } from 'astro:assets';
import { jobs, sections } from '@/data/cv';
import { formatPeriod, slugify } from '@/lib/format';
import Icon from '@/components/Icon.astro';
import TechChip from '@/components/TechChip.astro';
import Window from '@/components/Window.astro';

const section = sections.find((s) => s.id === 'experience')!;
---

<Window id="experience" title={section.title} icon={section.icon} tint={section.tint}>
  <ol class="timeline">
    {
      jobs.map((job) => (
        <li class="job" id={`job-${slugify(job.company)}`}>
          <div class="job-rail" aria-hidden="true">
            <span class="tile job-logo">
              <Image src={job.logo} alt="" width={112} height={112} />
            </span>
          </div>
          <article class="job-body">
            <header class="job-header">
              <span class="tile job-logo-inline" aria-hidden="true">
                <Image src={job.logo} alt="" width={96} height={96} />
              </span>
              <div class="job-heading">
                <h3>{job.role}</h3>
                <p class="job-company">
                  {job.company} <span class="faint">· {job.place}</span>
                </p>
                <p class="period">
                  {!job.period.to && <span class="live" />}
                  {formatPeriod(job.period)}
                </p>
              </div>
              {job.links.length > 0 && (
                <div class="job-links">
                  {job.links.map((link) => (
                    <a
                      class="glass glass-button icon-only"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${job.company} ${link.label}`}
                      title={link.label}
                    >
                      <Icon name={link.icon} />
                    </a>
                  ))}
                </div>
              )}
            </header>
            <p class="job-summary">{job.summary}</p>
            <ul class="job-highlights">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <ul class="stack" aria-label="Technologies">
              {job.stack.map((key) => (
                <li>
                  <TechChip id={key} />
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</Window>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .job {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 18px;
    border-radius: 20px;
  }

  .job + .job .job-body {
    padding-top: 26px;
  }

  .job + .job .job-rail {
    padding-top: 26px;
  }

  .job-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .job-rail::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(var(--sep), var(--sep));
  }

  .job:first-child .job-rail::after {
    top: 28px;
  }

  .job:last-child .job-rail::after {
    bottom: auto;
    height: 28px;
  }

  .job:only-child .job-rail::after {
    display: none;
  }

  .job-logo {
    --tile: 56px;
    position: sticky;
    top: calc(var(--menubar-h) + 80px);
  }

  .job-body {
    padding-bottom: 6px;
    min-width: 0;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .job-company {
    margin-top: 2px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .period {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-2);
    background: var(--fill-2);
    font-variant-numeric: tabular-nums;
  }

  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #30d158;
    box-shadow: 0 0 0 3px rgb(48 209 88 / 0.2);
  }

  .job-logo-inline {
    display: none;
    --tile: 48px;
  }

  .job-heading {
    flex: 1;
    min-width: 0;
  }

  .job-links {
    display: flex;
    gap: 8px;
  }

  .job-summary {
    margin-top: 14px;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .job-highlights {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 12px 0 16px;
    padding: 14px 16px;
    border-radius: var(--radius-group);
    background: var(--group-bg);
    box-shadow: inset 0 0 0 0.5px var(--sep);
    font-size: 14px;
  }

  .job-highlights li {
    position: relative;
    padding-left: 18px;
  }

  .job-highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .job-rail {
      display: none;
    }

    .job + .job {
      margin-top: 26px;
      padding-top: 0;
      border-top: 0.5px solid var(--sep);
    }

    .job-header {
      flex-wrap: wrap;
    }

    .job-logo-inline {
      display: grid;
    }

    .job-links {
      width: 100%;
    }

    h3 {
      font-size: 18px;
    }

    .job-highlights {
      padding: 12px 14px;
    }
  }
</style>
