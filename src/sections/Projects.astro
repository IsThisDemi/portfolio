---
import { Image } from 'astro:assets';
import { projects, sections } from '@/data/cv';
import { tech } from '@/data/tech';
import { formatPeriod, periodYears, slugify } from '@/lib/format';
import { iconSvg } from '@/lib/icon';
import Icon from '@/components/Icon.astro';
import TechChip from '@/components/TechChip.astro';
import Window from '@/components/Window.astro';

const section = sections.find((s) => s.id === 'projects')!;
const PREVIEW_CHIPS = 4;
---

<Window id="projects" title={section.title} icon={section.icon} tint={section.tint}>
  <p slot="toolbar" class="toolbar-hint">{projects.length} items</p>
  <ul class="project-grid">
    {
      projects.map((project) => {
        const id = `project-${slugify(project.name)}`;
        const extra = project.stack.length - PREVIEW_CHIPS;
        return (
          <li class="project-card" id={id}>
            <button class="project-open" data-quicklook={`${id}-quicklook`} aria-haspopup="dialog">
              <span class="visually-hidden">Open {project.name} details</span>
            </button>
            <div class="project-top">
              <span class="tile project-icon">
                <Image src={project.icon} alt="" width={128} height={128} />
              </span>
              <span class="project-years">{periodYears(project.period)}</span>
            </div>
            <h3>{project.name}</h3>
            <p class="project-tagline">{project.tagline}</p>
            <p class="project-description">{project.description}</p>
            <div class="project-footer">
              <ul class="mini-stack" aria-label="Technologies">
                {project.stack.slice(0, PREVIEW_CHIPS).map((key) => (
                  <li class="tile" title={tech[key].name}>
                    <Fragment
                      set:html={iconSvg(
                        tech[key].icon,
                        'color' in tech[key] ? { style: `color:${tech[key].color}` } : {},
                      )}
                    />
                  </li>
                ))}
                {extra > 0 && <li class="more">+{extra}</li>}
              </ul>
              <span class="project-more">
                Quick Look <Icon name="fa6-solid:chevron-right" />
              </span>
            </div>
          </li>
        );
      })
    }
  </ul>

  {
    projects.map((project) => {
      const id = `project-${slugify(project.name)}`;
      return (
        <dialog class="quicklook glass glass-strong" id={`${id}-quicklook`} aria-labelledby={`${id}-ql-title`}>
          <div class="ql-bar">
            <form method="dialog">
              <button class="glass glass-button icon-only" aria-label="Close">
                <Icon name="fa6-solid:xmark" />
              </button>
            </form>
            <span class="ql-title">{project.name}</span>
            <div class="ql-links">
              {project.links.map((link) => (
                <a class="glass glass-button" href={link.url} target="_blank" rel="noopener noreferrer">
                  <Icon name={link.icon} /> {link.label}
                </a>
              ))}
            </div>
          </div>
          <div class="ql-body">
            <header class="ql-header">
              <span class="tile ql-icon">
                <Image src={project.icon} alt="" width={160} height={160} />
              </span>
              <div>
                <h3 id={`${id}-ql-title`}>{project.name}</h3>
                <p class="muted">{project.tagline}</p>
                <p class="faint ql-period">{formatPeriod(project.period)}</p>
              </div>
            </header>
            {project.screenshots && (
              <div class="ql-gallery">
                {project.screenshots.map((shot) => (
                  <figure>
                    <Image src={shot.src} alt={shot.alt} width={960} />
                    <figcaption>{shot.alt}</figcaption>
                  </figure>
                ))}
              </div>
            )}
            <p class="ql-description">{project.description}</p>
            <dl class="ql-meta">
              <div>
                <dt>Team</dt>
                <dd>{project.team === 1 ? 'Solo' : `${project.team} people`}</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>{project.roles.join(', ')}</dd>
              </div>
              <div>
                <dt>Category</dt>
                <dd>{project.categories.join(', ')}</dd>
              </div>
            </dl>
            <ul class="ql-stack" aria-label="Technologies">
              {project.stack.map((key) => (
                <li>
                  <TechChip id={key} />
                </li>
              ))}
            </ul>
          </div>
        </dialog>
      );
    })
  }
</Window>

<script>
  // Quick Look opens out of the card it belongs to and shrinks back into it.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const originTransform = (dialog: HTMLDialogElement, card: HTMLElement) => {
    const from = card.getBoundingClientRect();
    const to = dialog.getBoundingClientRect();
    const dx = from.left + from.width / 2 - (to.left + to.width / 2);
    const dy = from.top + from.height / 2 - (to.top + to.height / 2);
    return `translate(${dx}px, ${dy}px) scale(${from.width / to.width}, ${from.height / to.height})`;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-quicklook]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.quicklook!) as HTMLDialogElement;
    const card = button.closest<HTMLElement>('.project-card')!;
    let closing = false;

    button.addEventListener('click', () => {
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      if (reducedMotion.matches) return;
      dialog.animate(
        [
          { transform: originTransform(dialog, card), opacity: 0.4, borderRadius: '22px' },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 480, easing: 'cubic-bezier(0.25, 1.15, 0.4, 1)' },
      );
    });

    // Intercept closing (Esc, close button, backdrop) to play the reverse animation first.
    const animateClose = () => {
      if (closing) return;
      closing = true;
      const finish = () => {
        dialog.close();
        closing = false;
        document.documentElement.style.overflow = '';
      };
      if (reducedMotion.matches) return finish();
      dialog
        .animate(
          [
            { transform: 'none', opacity: 1 },
            { transform: originTransform(dialog, card), opacity: 0 },
          ],
          {
            duration: 300,
            easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
          },
        )
        .finished.then(finish);
    };

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      animateClose();
    });
    dialog.querySelector('form')!.addEventListener('submit', (event) => {
      event.preventDefault();
      animateClose();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) animateClose();
    });
  });
</script>

<style>
  .toolbar-hint {
    font-size: 12.5px;
    color: var(--text-3);
    padding-right: 6px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 18px;
    border-radius: 20px;
    background: var(--group-bg);
    box-shadow: inset 0 0 0 0.5px var(--sep);
    transition:
      transform 0.45s var(--spring),
      box-shadow 0.3s ease,
      background-color 0.3s;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 0.5px var(--sep),
      0 18px 40px -18px rgb(0 0 0 / 0.4);
  }

  .project-card:has(.project-open:active) {
    transform: scale(0.98);
  }

  .project-open {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .project-icon {
    --tile: 56px;
    transition: transform 0.45s var(--spring);
  }

  .project-card:hover .project-icon {
    transform: scale(1.06) rotate(-3deg);
  }

  .project-years {
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-2);
    background: var(--fill-2);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .project-tagline {
    margin-top: 2px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--accent);
  }

  .project-description {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 16px;
  }

  .mini-stack {
    display: flex;
    align-items: center;
  }

  .mini-stack .tile {
    --tile: 26px;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px var(--win-bg),
      0 0 0 2.5px var(--tile-ring);
  }

  .mini-stack li + li {
    margin-left: -5px;
  }

  .more {
    padding-left: 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-3);
  }

  .project-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-3);
    transition:
      color 0.2s,
      gap 0.3s var(--spring);
  }

  .project-more :global(svg) {
    font-size: 10px;
  }

  .project-card:hover .project-more {
    color: var(--accent);
    gap: 8px;
  }

  /* ── Quick Look ── */
  .quicklook {
    width: min(720px, calc(100vw - 24px));
    max-height: min(86dvh, 860px);
    padding: 0;
    border: 0;
    border-radius: 28px;
    color: var(--text);
    overflow: hidden;
    --glass-blur: 44px;
  }

  .quicklook[open] {
    display: flex;
    flex-direction: column;
  }

  .quicklook::backdrop {
    background: rgb(0 0 0 / 0.3);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .ql-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 12px 0;
  }

  .ql-title {
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    color: var(--text-2);
  }

  .ql-links {
    display: flex;
    gap: 8px;
  }

  .ql-body {
    overflow-y: auto;
    padding: 18px 26px 26px;
    overscroll-behavior: contain;
  }

  .ql-header {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .ql-icon {
    --tile: 80px;
  }

  .ql-header h3 {
    margin: 0;
    font-size: 26px;
  }

  .ql-period {
    margin-top: 4px;
    font-size: 13px;
  }

  .ql-gallery {
    display: flex;
    gap: 12px;
    margin: 20px -26px 0;
    padding: 0 26px 4px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 26px;
  }

  .ql-gallery figure {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }

  .ql-gallery img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 0 0 0.5px var(--sep);
  }

  .ql-gallery figcaption {
    margin-top: 6px;
    font-size: 12px;
    color: var(--text-3);
  }

  .ql-description {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.6;
  }

  .ql-meta {
    margin: 18px 0;
    border-radius: var(--radius-group);
    background: var(--fill);
    box-shadow: inset 0 0 0 0.5px var(--sep);
  }

  .ql-meta div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 14px;
    font-size: 13.5px;
  }

  .ql-meta div + div {
    box-shadow: inset 0 0.5px 0 var(--sep);
  }

  .ql-meta dt {
    font-weight: 600;
  }

  .ql-meta dd {
    margin: 0;
    text-align: right;
    color: var(--text-2);
  }

  .ql-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .quicklook {
      width: calc(100vw - 16px);
      max-height: calc(100dvh - 40px);
      border-radius: 26px;
    }

    .ql-links .glass-button {
      width: 34px;
      padding: 0;
      font-size: 0;
    }

    .ql-links .glass-button :global(svg) {
      font-size: 15px;
    }

    .ql-body {
      padding: 14px 18px 22px;
    }

    .ql-gallery {
      margin: 18px -18px 0;
      padding: 0 18px 4px;
      scroll-padding: 0 18px;
    }

    .ql-header h3 {
      font-size: 22px;
    }

    .ql-icon {
      --tile: 64px;
    }
  }
</style>
