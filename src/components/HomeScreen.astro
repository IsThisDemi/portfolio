---
import { Image } from 'astro:assets';
import { profile } from '@/data/cv';
import { webLinks } from '@/data/apps';
import type { ArtName } from '@/data/art';
import AppArt from './AppArt.astro';
import Glyph from './Glyph.astro';

type Icon = { label: string; art: ArtName; app?: string; url?: string; download?: string };

const grid: Icon[] = [
  { label: 'Terminal', art: 'terminal', app: 'terminal' },
  { label: 'Résumé', art: 'pdf', url: profile.cv.url },
  ...webLinks.map((link) => ({ label: link.label, art: link.art, url: link.url })),
];

const dock: Icon[] = [
  { label: 'Contacts', art: 'contacts', app: 'contacts' },
  { label: 'Notes', art: 'notes', app: 'notes' },
  { label: 'Files', art: 'finder', app: 'finder' },
  { label: 'Mail', art: 'mail', app: 'mail' },
];

const location = profile.details.find((detail) => detail.label === 'Location')!.value;
---

<div class="home" aria-label="Home Screen">
  <div class="ios-status" aria-hidden="true">
    <time data-ios-clock>9:41</time>
    <span class="ios-status-icons">
      <svg viewBox="0 0 18 12"
        ><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"
        ></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"
        ></rect></svg
      >
      <Glyph name="wifi" />
      <svg viewBox="0 0 27 13" class="battery"
        ><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" opacity="0.4"
        ></rect><rect x="2" y="2" width="16" height="9" rx="2"></rect><path d="M25 4.5v4a2 2 0 0 0 0-4Z" opacity="0.45"
        ></path></svg
      >
    </span>
  </div>

  <button class="widget" data-open-app="contacts" aria-label={`${profile.name}, open contact card`}>
    <Image src={profile.photo} alt="" width={140} height={140} class="widget-photo" />
    <span class="widget-text">
      <strong>{profile.name}</strong>
      <span>{profile.role}</span>
      <span class="widget-meta">
        <span class="widget-dot"></span>
        {location} · open to work
      </span>
    </span>
  </button>

  <ul class="home-grid">
    {
      grid.map((icon) => (
        <li>
          {icon.app ? (
            <button class="home-app" data-open-app={icon.app}>
              <span class="home-icon">
                <AppArt name={icon.art} />
              </span>
              <span class="home-label">{icon.label}</span>
            </button>
          ) : (
            <a class="home-app" href={icon.url} target="_blank" rel="noopener noreferrer">
              <span class="home-icon">
                <AppArt name={icon.art} />
              </span>
              <span class="home-label">{icon.label}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <div class="home-bottom">
    <button class="home-search" data-spotlight>
      <Glyph name="search" /> Search
    </button>
    <ul class="home-dock" data-liquid>
      {
        dock.map((icon) => (
          <li>
            <button class="home-app" data-open-app={icon.app} aria-label={icon.label}>
              <span class="home-icon">
                <AppArt name={icon.art} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const clock = document.querySelector<HTMLTimeElement>('[data-ios-clock]')!;
  const format = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', hour12: false });
  const tick = () => (clock.textContent = format.format(new Date()));
  tick();
  setInterval(tick, 10_000);

  document
    .querySelector('[data-spotlight]')!
    .addEventListener('click', () => document.dispatchEvent(new CustomEvent('spotlight:open')));
</script>

<style is:global>
  .home {
    display: none;
  }

  @media (max-width: 899px) {
    .home {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      padding: env(safe-area-inset-top) 22px calc(10px + env(safe-area-inset-bottom));
      color: #fff;
      overflow: hidden;
    }

    .ios-status {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 50px;
      padding: 0 12px 0 16px;
      font-size: 16px;
      font-weight: 600;
      text-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
    }

    .ios-status-icons {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .ios-status-icons svg {
      height: 12px;
      width: auto;
      fill: currentColor;
    }

    .ios-status-icons .glyph {
      height: 15px;
      width: 15px;
      fill: none;
    }

    .ios-status-icons .battery {
      height: 13px;
    }

    .widget {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 18px;
      padding: 16px;
      border-radius: 26px;
      text-align: left;
      color: #fff;
      background: rgb(255 255 255 / 0.16);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      backdrop-filter: blur(24px) saturate(160%);
      box-shadow:
        inset 0 0.5px 0 rgb(255 255 255 / 0.45),
        inset 0 0 0 0.5px rgb(255 255 255 / 0.2),
        0 10px 30px -12px rgb(0 0 0 / 0.35);
      animation: home-in 0.6s var(--spring-soft) both;
    }

    .widget:active {
      transform: scale(0.97);
    }

    .widget-photo {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
      box-shadow: 0 0 0 2px rgb(255 255 255 / 0.4);
    }

    .widget-text {
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 0;
      font-size: 14px;
      line-height: 1.3;
    }

    .widget-text strong {
      font-size: 18px;
      font-weight: 650;
    }

    .widget-text > span {
      color: rgb(255 255 255 / 0.82);
    }

    .widget-meta {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 4px;
      font-size: 13px;
    }

    .widget-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #30d158;
    }

    .home-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px 10px;
      margin-top: 28px;
    }

    .home-app {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      width: 100%;
      color: #fff;
    }

    .home-icon {
      display: block;
      width: 64px;
      height: 64px;
      transition: transform 0.25s var(--spring);
    }

    .home-icon .app-art {
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 3px 6px rgb(0 0 0 / 0.25));
    }

    .home-app:active .home-icon {
      transform: scale(0.9);
      filter: brightness(0.85);
    }

    .home-label {
      font-size: 12px;
      font-weight: 500;
      text-shadow: 0 1px 3px rgb(0 0 0 / 0.45);
    }

    .home-grid li {
      animation: home-in 0.55s var(--spring-soft) both;
    }

    .home-grid li:nth-child(2) {
      animation-delay: 40ms;
    }
    .home-grid li:nth-child(3) {
      animation-delay: 80ms;
    }
    .home-grid li:nth-child(4) {
      animation-delay: 120ms;
    }

    @keyframes home-in {
      from {
        opacity: 0;
        transform: scale(0.85);
      }
    }

    .home-bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      margin-top: auto;
    }

    .home-search {
      display: flex;
      align-items: center;
      gap: 5px;
      height: 32px;
      padding: 0 14px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      background: rgb(255 255 255 / 0.2);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
      box-shadow: inset 0 0.5px 0 rgb(255 255 255 / 0.4);
    }

    .home-search .glyph {
      width: 14px;
      height: 14px;
      stroke-width: 2.2;
    }

    .home-dock {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      width: 100%;
      padding: 14px 12px;
      border-radius: 34px;
      background: rgb(255 255 255 / 0.18);
      -webkit-backdrop-filter: blur(22px) saturate(170%);
      backdrop-filter: blur(22px) saturate(170%);
      box-shadow:
        inset 0 0.5px 0 rgb(255 255 255 / 0.45),
        inset 0 0 0 0.5px rgb(255 255 255 / 0.18);
      --glass-blur: 22px;
      animation: home-in 0.6s var(--spring-soft) both 0.1s;
    }
  }
</style>
