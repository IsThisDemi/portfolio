---
import { Image } from 'astro:assets';
import { profile } from '@/data/cv';
import { apps } from '@/data/apps';
import Glyph from './Glyph.astro';

const accents = [
  ['blue', '#0a84ff'],
  ['purple', '#a550e6'],
  ['pink', '#f2418d'],
  ['red', '#ff453a'],
  ['orange', '#ff8a00'],
  ['yellow', '#f5c400'],
  ['green', '#2fb84f'],
  ['graphite', '#8e8e93'],
] as const;

const wallpapers = [
  ['lake', 'Lake', 'linear-gradient(160deg, #8fd3ff, #2a6df0 55%, #0a1f5c)'],
  ['dusk', 'Dusk', 'linear-gradient(160deg, #ffb38a, #e0628f 50%, #44207a)'],
  ['meadow', 'Meadow', 'linear-gradient(160deg, #b7f0d9, #43c28a 50%, #0f5c5a)'],
  ['graphite', 'Graphite', 'linear-gradient(160deg, #e6e7ea, #8e939d 50%, #26282d)'],
] as const;
---

<header class="menubar" data-email={profile.email}>
  <nav class="menubar-left" aria-label="Menu bar">
    <div class="mb-menu">
      <button class="mb-item mb-avatar" data-menu aria-haspopup="menu" aria-expanded="false" aria-label="Riccardo menu">
        <Image src={profile.photo} alt="" width={40} height={40} />
      </button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-open-app="contacts">About Riccardo</button>
        <button role="menuitem" data-open-app="preview">Résumé…</button>
        <hr />
        <button role="menuitem" data-command="control-center">Appearance…</button>
        <hr />
        <button role="menuitem" data-command="restart">Restart…</button>
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item mb-app" data-menu aria-haspopup="menu" aria-expanded="false" data-app-name>Notes</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-command="minimize">Hide <span data-app-name>Notes</span></button>
        <hr />
        <button role="menuitem" data-command="close">Quit <span data-app-name>Notes</span></button>
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item" data-menu aria-haspopup="menu" aria-expanded="false">File</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-open-app="mail">New Message</button>
        <button role="menuitem" data-open-app="terminal">New Terminal Window</button>
        <button role="menuitem" data-open-app="preview">Open Résumé</button>
        <hr />
        <button role="menuitem" data-command="close">Close Window</button>
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item" data-menu aria-haspopup="menu" aria-expanded="false">Edit</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-command="copy-email">Copy Email Address</button>
        <button role="menuitem" data-command="copy-link">Copy Link to This Window</button>
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item" data-menu aria-haspopup="menu" aria-expanded="false">View</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-command="dark">Dark Appearance</button>
        <button role="menuitem" data-command="light">Light Appearance</button>
        <hr />
        <button role="menuitem" data-command="zoom">Enter Full Screen</button>
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item" data-menu aria-haspopup="menu" aria-expanded="false">Go</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-open-app="finder" data-select="projects">Projects</button>
        <button role="menuitem" data-open-app="finder" data-select="stack">Stack</button>
        <button role="menuitem" data-open-app="notes">Experience</button>
        <hr />
        {
          profile.links.map((link) => (
            <a role="menuitem" href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item" data-menu aria-haspopup="menu" aria-expanded="false">Window</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-command="minimize">Minimize</button>
        <button role="menuitem" data-command="zoom">Zoom</button>
        <hr />
        {
          apps.map((app) => (
            <button role="menuitemcheckbox" data-open-app={app.id} data-window-item={app.id} aria-checked="false">
              {app.name}
            </button>
          ))
        }
        <hr />
        <button role="menuitem" data-command="bring-all">Bring All to Front</button>
      </div>
    </div>

    <div class="mb-menu">
      <button class="mb-item" data-menu aria-haspopup="menu" aria-expanded="false">Help</button>
      <div class="mb-dropdown" role="menu" hidden>
        <button role="menuitem" data-command="spotlight">Search <kbd>⌘K</kbd></button>
        <button role="menuitem" data-open-app="terminal">Ask the Terminal</button>
      </div>
    </div>
  </nav>

  <div class="menubar-right">
    <span class="mb-status" aria-hidden="true"><Glyph name="wifi" /></span>
    <button class="mb-item mb-icon" data-command="spotlight" aria-label="Spotlight"><Glyph name="search" /></button>
    <button class="mb-item mb-icon" data-command="control-center" aria-label="Control Center" aria-expanded="false">
      <Glyph name="switches" />
    </button>
    <time class="mb-clock" data-clock></time>
  </div>

  <div class="control-center" role="dialog" aria-label="Control Center" hidden>
    <section class="cc-module">
      <h3>Appearance</h3>
      <div class="segmented" role="radiogroup" aria-label="Appearance">
        <span class="segmented-thumb" aria-hidden="true"></span>
        <button role="radio" data-theme-option="light"><Glyph name="sun" /> Light</button>
        <button role="radio" data-theme-option="dark"><Glyph name="moon" /> Dark</button>
        <button role="radio" data-theme-option="auto">Auto</button>
      </div>
    </section>
    <section class="cc-module">
      <h3>Accent color</h3>
      <div class="accent-swatches" role="radiogroup" aria-label="Accent color">
        {
          accents.map(([name, color]) => (
            <button role="radio" data-accent-option={name} style={`--swatch:${color}`} aria-label={name} />
          ))
        }
      </div>
    </section>
    <section class="cc-module">
      <h3>Wallpaper</h3>
      <div class="wallpaper-options" role="radiogroup" aria-label="Wallpaper">
        {
          wallpapers.map(([name, label, preview]) => (
            <button role="radio" data-wallpaper-option={name} aria-label={label}>
              <span style={`background:${preview}`} />
              {label}
            </button>
          ))
        }
      </div>
    </section>
  </div>
</header>

<script>
  import {
    appName,
    closeApp,
    focusedApp,
    isOpen,
    minimizeApp,
    onAppsChange,
    restoreAll,
    toggleZoom,
  } from '@/scripts/shell';
  import { getAccent, getTheme, getWallpaper, setAccent, setTheme, setWallpaper, type Theme } from '@/scripts/prefs';
  import { notify } from '@/scripts/notify';

  const bar = document.querySelector<HTMLElement>('.menubar')!;
  const menus = [...bar.querySelectorAll<HTMLElement>('.mb-menu')];
  const cc = bar.querySelector<HTMLElement>('.control-center')!;
  const ccButton = bar.querySelector<HTMLElement>('.mb-icon[data-command="control-center"]')!;
  let openMenu: HTMLElement | null = null;

  // ── Menus: click to open; while one is open, hovering another title switches to it. ──
  const setMenu = (menu: HTMLElement | null) => {
    if (openMenu && openMenu !== menu) {
      openMenu.querySelector<HTMLElement>('.mb-dropdown')!.hidden = true;
      openMenu.querySelector('[data-menu]')!.setAttribute('aria-expanded', 'false');
    }
    openMenu = menu;
    if (menu) {
      menu.querySelector<HTMLElement>('.mb-dropdown')!.hidden = false;
      menu.querySelector('[data-menu]')!.setAttribute('aria-expanded', 'true');
      setCC(false);
    }
  };

  function setCC(show: boolean) {
    cc.hidden = !show;
    ccButton.setAttribute('aria-expanded', String(show));
    if (show) {
      setMenu(null);
      syncControls();
    }
  }

  for (const menu of menus) {
    const title = menu.querySelector<HTMLElement>('[data-menu]')!;
    title.addEventListener('click', (event) => {
      event.stopPropagation();
      setMenu(openMenu === menu ? null : menu);
    });
    title.addEventListener('pointerenter', () => openMenu && openMenu !== menu && setMenu(menu));
    menu.querySelector('.mb-dropdown')!.addEventListener('click', () => setMenu(null));
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (!target.closest('.mb-menu')) setMenu(null);
    if (!target.closest('.control-center, [data-command="control-center"]')) setCC(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenu(null);
      setCC(false);
    }
  });

  // ── Commands ──
  const copy = async (text: string, title: string) => {
    try {
      await navigator.clipboard.writeText(text);
      notify({ title, body: text, icon: 'copy' });
    } catch {
      notify({ title: 'Could not copy', body: text });
    }
  };

  bar.addEventListener('click', (event) => {
    const command = (event.target as Element).closest<HTMLElement>('[data-command]')?.dataset.command;
    const focused = focusedApp();
    switch (command) {
      case 'control-center':
        event.stopPropagation();
        setCC(cc.hidden);
        break;
      case 'spotlight':
        document.dispatchEvent(new CustomEvent('spotlight:open'));
        break;
      case 'close':
        if (focused) closeApp(focused);
        break;
      case 'minimize':
        if (focused) minimizeApp(focused);
        break;
      case 'zoom':
        if (focused) toggleZoom(focused);
        break;
      case 'bring-all':
        restoreAll();
        break;
      case 'copy-email':
        copy(bar.dataset.email!, 'Email address copied');
        break;
      case 'copy-link':
        copy(`${location.origin}${location.pathname}${focused ? `#${focused}` : ''}`, 'Link copied');
        break;
      case 'dark':
      case 'light':
        setTheme(command);
        break;
      case 'restart':
        document.documentElement.classList.add('is-restarting');
        setTimeout(() => location.assign(location.pathname), 700);
        break;
    }
  });

  // ── Focused app name and Window menu checkmarks ──
  onAppsChange(() => {
    const name = appName(focusedApp()) || 'Finder';
    bar.querySelectorAll('[data-app-name]').forEach((el) => (el.textContent = name));
    bar.querySelectorAll<HTMLElement>('[data-window-item]').forEach((item) => {
      item.setAttribute('aria-checked', String(item.dataset.windowItem === focusedApp()));
      item.classList.toggle('is-running', isOpen(item.dataset.windowItem!));
    });
  });

  // ── Control Center ──
  const themeButtons = [...cc.querySelectorAll<HTMLButtonElement>('[data-theme-option]')];
  const thumb = cc.querySelector<HTMLElement>('.segmented-thumb')!;
  const accentButtons = [...cc.querySelectorAll<HTMLButtonElement>('[data-accent-option]')];
  const wallpaperButtons = [...cc.querySelectorAll<HTMLButtonElement>('[data-wallpaper-option]')];

  const check = (buttons: HTMLButtonElement[], key: string, value: string) =>
    buttons.forEach((button) => button.setAttribute('aria-checked', String(button.dataset[key] === value)));

  function syncControls() {
    const theme = getTheme();
    check(themeButtons, 'themeOption', theme);
    const current = themeButtons.find((button) => button.dataset.themeOption === theme)!;
    thumb.style.width = `${current.offsetWidth}px`;
    thumb.style.transform = `translateX(${current.offsetLeft}px)`;
    check(accentButtons, 'accentOption', getAccent());
    check(wallpaperButtons, 'wallpaperOption', getWallpaper());
  }

  themeButtons.forEach((button) =>
    button.addEventListener('click', () => {
      setTheme(button.dataset.themeOption as Theme);
      syncControls();
    }),
  );
  accentButtons.forEach((button) =>
    button.addEventListener('click', () => {
      setAccent(button.dataset.accentOption!);
      syncControls();
    }),
  );
  wallpaperButtons.forEach((button) =>
    button.addEventListener('click', () => {
      setWallpaper(button.dataset.wallpaperOption!);
      syncControls();
    }),
  );

  // ── Clock, in the menu bar's format: "Fri Oct 23  11:02 AM" ──
  const clock = bar.querySelector<HTMLTimeElement>('[data-clock]')!;
  const day = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  const time = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });
  const tick = () => {
    const now = new Date();
    clock.textContent = `${day.format(now).replace(',', '')}  ${time.format(now)}`;
    clock.dateTime = now.toISOString();
  };
  tick();
  setInterval(tick, 10_000);
</script>

<style is:global>
  :root {
    --menubar-ink: #1d1d1f;
    --menubar-scrim: rgb(255 255 255 / 0.2);
    --menubar-shadow: rgb(255 255 255 / 0.35);
  }

  :root.dark {
    --menubar-ink: #fff;
    --menubar-scrim: rgb(0 0 0 / 0.2);
    --menubar-shadow: rgb(0 0 0 / 0.35);
  }

  .menubar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--menubar-h);
    padding: 0 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--menubar-ink);
    /* Tahoe's menu bar has no background, only a soft scrim for legibility. */
    background: linear-gradient(to bottom, var(--menubar-scrim), transparent);
    text-shadow: 0 0.5px 1px var(--menubar-shadow);
  }

  .menubar-left,
  .menubar-right {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .mb-menu {
    position: relative;
  }

  .mb-item {
    display: flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .mb-item:hover,
  .mb-item[aria-expanded='true'] {
    background: color-mix(in srgb, var(--menubar-ink) 14%, transparent);
  }

  .mb-app {
    font-weight: 700;
  }

  .mb-avatar img {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--menubar-ink) 35%, transparent);
  }

  .mb-icon {
    width: 32px;
    padding: 0;
    justify-content: center;
  }

  .mb-icon .glyph,
  .mb-status .glyph {
    width: 16px;
    height: 16px;
  }

  .mb-status {
    display: grid;
    place-items: center;
    width: 30px;
  }

  .mb-clock {
    padding: 0 8px 0 6px;
    white-space: pre;
    font-variant-numeric: tabular-nums;
  }

  /* ── Dropdown menus ── */
  .mb-dropdown,
  .control-center {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 2;
    color: var(--label);
    text-shadow: none;
    background: var(--popover-bg);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    backdrop-filter: blur(40px) saturate(180%);
    box-shadow:
      0 0 0 0.5px var(--window-ring),
      inset 0 0.5px 0 rgb(255 255 255 / 0.25),
      0 14px 40px -10px rgb(0 0 0 / 0.4);
  }

  .mb-dropdown {
    display: flex;
    flex-direction: column;
    min-width: 230px;
    padding: 5px;
    border-radius: 12px;
    animation: menu-in 0.16s ease-out;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }

  .mb-dropdown button,
  .mb-dropdown a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 3px 10px 3px 22px;
    border-radius: 6px;
    font-weight: 400;
    text-align: left;
  }

  .mb-dropdown [aria-checked='true']::before {
    content: '✓';
    position: absolute;
    left: 7px;
    font-size: 11px;
  }

  .mb-dropdown .is-running::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .mb-dropdown button:hover,
  .mb-dropdown a:hover,
  .mb-dropdown button:focus-visible,
  .mb-dropdown a:focus-visible {
    background: var(--accent);
    color: #fff;
    outline: none;
  }

  .mb-dropdown hr {
    margin: 4px 10px;
    border: 0;
    border-top: 1px solid var(--separator);
  }

  .mb-dropdown kbd {
    font: inherit;
    opacity: 0.55;
  }

  /* ── Control Center ── */
  .control-center {
    left: auto;
    right: 6px;
    display: grid;
    gap: 8px;
    width: 320px;
    padding: 10px;
    border-radius: 22px;
    animation: popover-in 0.3s var(--spring);
  }

  @keyframes popover-in {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(-6px);
    }
  }

  .cc-module {
    padding: 11px 12px 12px;
    border-radius: 16px;
    background: var(--fill-2);
  }

  .cc-module h3 {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--label-2);
  }

  .segmented {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 2px;
    border-radius: 999px;
    background: var(--fill-2);
  }

  .segmented button {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 28px;
    font-size: 12.5px;
  }

  .segmented .glyph {
    width: 14px;
    height: 14px;
  }

  .segmented-thumb {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 0;
    border-radius: 999px;
    background: var(--control-bg);
    box-shadow: var(--control-shadow);
    transition:
      transform 0.4s var(--spring),
      width 0.4s var(--spring);
  }

  .accent-swatches {
    display: flex;
    justify-content: space-between;
  }

  .accent-swatches button {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.15);
  }

  .accent-swatches [aria-checked='true'] {
    box-shadow:
      0 0 0 2px var(--popover-bg),
      0 0 0 4px var(--swatch);
  }

  .wallpaper-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .wallpaper-options button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--label-2);
  }

  .wallpaper-options span {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 7px;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.15);
  }

  .wallpaper-options [aria-checked='true'] {
    color: var(--label);
    font-weight: 600;
  }

  .wallpaper-options [aria-checked='true'] span {
    box-shadow:
      0 0 0 2px var(--popover-bg),
      0 0 0 4px var(--accent);
  }

  @media (max-width: 1180px) {
    .mb-menu:nth-child(n + 6) {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .menubar {
      display: none;
    }
  }

  .is-restarting body {
    animation: restart 0.7s ease-in forwards;
  }

  @keyframes restart {
    to {
      filter: brightness(0);
    }
  }
</style>
