---
import { apps, webLinks } from '@/data/apps';
import AppArt from './AppArt.astro';
---

<nav class="dock-wrap" aria-label="Dock">
  <div class="dock" data-liquid>
    <ul class="dock-items">
      {
        apps.map((app) => (
          <li>
            <button class="dock-item" data-open-app={app.id} aria-label={app.name}>
              <AppArt name={app.art} />
              <span class="dock-label">{app.name}</span>
              <span class="dock-dot" aria-hidden="true" />
            </button>
          </li>
        ))
      }
      <li class="dock-separator" aria-hidden="true"></li>
      {
        webLinks.map((link) => (
          <li>
            <a class="dock-item" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
              <AppArt name={link.art} />
              <span class="dock-label">{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  import { isOpen, onAppsChange } from '@/scripts/shell';

  const dock = document.querySelector<HTMLElement>('.dock')!;
  const items = [...dock.querySelectorAll<HTMLElement>('.dock-item')];
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  // Magnification: icons swell toward the pointer along a cosine curve, like the real Dock.
  const BASE = 54;
  const MAX = 82;
  const RANGE = 160;

  dock.addEventListener('pointermove', (event) => {
    if (!finePointer.matches || event.pointerType !== 'mouse') return;
    dock.classList.add('is-magnifying');
    for (const item of items) {
      const rect = item.getBoundingClientRect();
      const distance = Math.abs(event.clientX - (rect.left + rect.width / 2));
      const t = Math.max(0, 1 - distance / RANGE);
      item.style.setProperty('--icon', `${BASE + (MAX - BASE) * ((1 - Math.cos(Math.PI * t)) / 2)}px`);
    }
  });

  dock.addEventListener('pointerleave', () => {
    dock.classList.remove('is-magnifying');
    items.forEach((item) => item.style.removeProperty('--icon'));
  });

  // Launch bounce, only when the app was not running yet.
  for (const item of items) {
    item.addEventListener('click', () => {
      const id = item.dataset.openApp;
      if (id && isOpen(id)) return;
      item.classList.remove('is-bouncing');
      void item.offsetWidth;
      item.classList.add('is-bouncing');
    });
    item.addEventListener('animationend', () => item.classList.remove('is-bouncing'));
  }

  onAppsChange(() => {
    for (const item of items) {
      if (item.dataset.openApp) item.classList.toggle('is-running', isOpen(item.dataset.openApp));
    }
  });
</script>

<style is:global>
  .dock-wrap {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 6px;
    z-index: 50;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .dock {
    position: relative;
    padding: 6px 7px 7px;
    border-radius: 26px;
    pointer-events: auto;
    background: var(--dock-tint);
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px)) saturate(180%);
    backdrop-filter: blur(var(--glass-blur, 14px)) saturate(180%);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 10px 30px -8px rgb(0 0 0 / 0.3);
    --glass-blur: 12px;
    animation: dock-rise 0.8s var(--spring-soft) both 0.1s;
  }

  :root {
    --dock-tint: rgb(255 255 255 / 0.26);
  }

  :root.dark {
    --dock-tint: rgb(60 60 66 / 0.32);
  }

  @keyframes dock-rise {
    from {
      transform: translateY(130%);
    }
  }

  .dock-items {
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }

  .dock-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    outline-offset: 3px;
  }

  .dock-item .app-art {
    width: var(--icon, 54px);
    height: var(--icon, 54px);
    filter: drop-shadow(0 3px 5px rgb(0 0 0 / 0.22));
    transition:
      width 0.4s var(--spring),
      height 0.4s var(--spring);
  }

  .dock.is-magnifying .app-art {
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
  }

  .dock-item:active .app-art {
    filter: drop-shadow(0 3px 5px rgb(0 0 0 / 0.22)) brightness(0.75);
  }

  .dock-item.is-bouncing .app-art {
    animation: dock-bounce 0.9s cubic-bezier(0.3, 0, 0.3, 1);
  }

  @keyframes dock-bounce {
    0%,
    50%,
    85%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-24px);
    }
    70% {
      transform: translateY(-10px);
    }
  }

  .dock-label {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 13px;
    white-space: nowrap;
    color: var(--label);
    background: var(--popover-bg);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    box-shadow:
      0 0 0 0.5px var(--window-ring),
      0 6px 16px -6px rgb(0 0 0 / 0.35);
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.12s;
    pointer-events: none;
  }

  .dock-item:hover .dock-label,
  .dock-item:focus-visible .dock-label {
    opacity: 1;
  }

  .dock-dot {
    position: absolute;
    bottom: -5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--menubar-ink);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .dock-item.is-running .dock-dot {
    opacity: 0.75;
  }

  .dock-separator {
    align-self: stretch;
    width: 1px;
    margin: 6px 5px;
    background: rgb(255 255 255 / 0.3);
  }

  @media (max-width: 899px) {
    .dock-wrap {
      display: none;
    }
  }
</style>
