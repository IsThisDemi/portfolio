---
import { education, jobs, profile, projects, skills } from '@/data/cv';
import { apps } from '@/data/apps';
import { tech } from '@/data/tech';
import { slugify } from '@/lib/format';
import { iconSvg } from '@/lib/icon';
import { getImage } from 'astro:assets';

interface Entry {
  title: string;
  subtitle: string;
  kind: string;
  app?: string;
  select?: string;
  url?: string;
  /** Image URL, or inline SVG markup. */
  icon: string;
  keywords?: string;
}

const thumb = async (src: ImageMetadata) => (await getImage({ src, width: 64, height: 64, format: 'webp' })).src;
const glyph = (name: string) => iconSvg(name);

const entries: Entry[] = [
  ...apps.map((app) => ({
    title: app.name,
    subtitle: 'Application',
    kind: 'Applications',
    app: app.id,
    icon: `art:${app.art}`,
  })),
  ...(await Promise.all(
    projects.map(async (project) => ({
      title: project.name,
      subtitle: `${project.categories[0]} — Finder`,
      kind: 'Projects',
      app: 'finder',
      select: `project-${slugify(project.name)}`,
      icon: await thumb(project.icon),
      keywords: [...project.stack.map((key) => tech[key].name), ...project.categories, project.description].join(' '),
    })),
  )),
  ...(await Promise.all(
    jobs.map(async (job) => ({
      title: `${job.role} at ${job.company}`,
      subtitle: 'Notes',
      kind: 'Experience',
      app: 'notes',
      select: `note-${slugify(job.company)}`,
      icon: await thumb(job.logo),
      keywords: [...job.stack.map((key) => tech[key].name), ...job.highlights].join(' '),
    })),
  )),
  ...(await Promise.all(
    education.map(async (diploma) => ({
      title: diploma.title,
      subtitle: `${diploma.institution} — Notes`,
      kind: 'Education',
      app: 'notes',
      select: `note-${slugify(diploma.title)}`,
      icon: await thumb(diploma.logo),
    })),
  )),
  ...skills.flatMap((group) =>
    group.items.map((key) => ({
      title: tech[key].name,
      subtitle: `${group.title} — Stack`,
      kind: 'Stack',
      app: 'finder',
      select: 'stack',
      icon: iconSvg(tech[key].icon),
    })),
  ),
  ...profile.links.map((link) => ({
    title: link.label,
    subtitle: link.url.replace(/^https?:\/\/(www\.)?/, ''),
    kind: 'Links',
    url: link.url,
    icon: glyph(link.icon),
  })),
  { title: 'Résumé.pdf', subtitle: 'PDF document', kind: 'Documents', app: 'preview', icon: 'art:pdf' },
];
---

<div class="spotlight" hidden>
  <div class="spotlight-scrim"></div>
  <div class="spotlight-panel" role="dialog" aria-modal="true" aria-label="Spotlight">
    <label class="spotlight-field">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg
      >
      <input
        type="search"
        placeholder="Spotlight Search"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="spotlight-results"
        aria-autocomplete="list"
      />
    </label>
    <ul class="spotlight-results" id="spotlight-results" role="listbox"></ul>
  </div>
</div>

<script type="application/json" id="spotlight-index" set:html={JSON.stringify(entries)} />

<script>
  import { openApp } from '@/scripts/shell';

  interface Entry {
    title: string;
    subtitle: string;
    kind: string;
    app?: string;
    select?: string;
    url?: string;
    icon: string;
    keywords?: string;
  }

  const root = document.querySelector<HTMLElement>('.spotlight')!;
  const input = root.querySelector('input')!;
  const list = root.querySelector<HTMLUListElement>('.spotlight-results')!;
  const entries: Entry[] = JSON.parse(document.getElementById('spotlight-index')!.textContent!);

  let results: Entry[] = [];
  let selected = 0;

  const score = (entry: Entry, query: string) => {
    const title = entry.title.toLowerCase();
    if (title.startsWith(query)) return 4;
    if (title.split(/[\s·]+/).some((word) => word.startsWith(query))) return 3;
    if (title.includes(query)) return 2;
    return `${entry.subtitle} ${entry.keywords ?? ''}`.toLowerCase().includes(query) ? 1 : 0;
  };

  const iconHtml = (icon: string) => {
    if (icon.startsWith('art:')) {
      // Clone a visible copy: its gradients are referenced by id and must be rendered somewhere.
      const art = [...document.querySelectorAll<SVGElement>(`.app-art[data-art="${icon.slice(4)}"]`)].find(
        (candidate) => candidate.getBoundingClientRect().width > 0,
      );
      return art ? art.outerHTML : '';
    }
    if (icon.startsWith('<svg')) return `<span class="spotlight-glyph">${icon}</span>`;
    return `<img src="${icon}" alt="" />`;
  };

  const render = () => {
    const query = input.value.trim().toLowerCase();
    list.replaceChildren();
    root.classList.toggle('has-query', !!query);
    if (!query) {
      results = [];
      return;
    }
    results = entries
      .map((entry) => ({ entry, score: score(entry, query) }))
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 10)
      .map((item) => item.entry);

    if (!results.length) {
      const empty = document.createElement('li');
      empty.className = 'spotlight-empty';
      empty.textContent = 'No Results';
      list.append(empty);
      return;
    }

    // Group by kind, keeping the order of the best match in each group.
    const kinds = [...new Set(results.map((entry) => entry.kind))];
    results = kinds.flatMap((kind) => results.filter((entry) => entry.kind === kind));
    let lastKind = '';
    results.forEach((entry, index) => {
      if (entry.kind !== lastKind) {
        lastKind = entry.kind;
        const heading = document.createElement('li');
        heading.className = 'spotlight-kind';
        heading.setAttribute('role', 'presentation');
        heading.textContent = entry.kind;
        list.append(heading);
      }
      const item = document.createElement('li');
      item.className = 'spotlight-item';
      item.id = `spotlight-option-${index}`;
      item.setAttribute('role', 'option');
      item.innerHTML = `<span class="spotlight-icon">${iconHtml(entry.icon)}</span><span class="spotlight-text"><strong></strong><span></span></span>`;
      item.querySelector('strong')!.textContent = entry.title;
      item.querySelector('.spotlight-text span')!.textContent = entry.subtitle;
      item.addEventListener('pointermove', () => select(index));
      item.addEventListener('click', () => choose(entry));
      list.append(item);
    });
    select(0);
  };

  const select = (index: number) => {
    selected = index;
    list
      .querySelectorAll('.spotlight-item')
      .forEach((item, i) => item.setAttribute('aria-selected', String(i === index)));
    input.setAttribute('aria-activedescendant', `spotlight-option-${index}`);
    list.querySelector(`#spotlight-option-${index}`)?.scrollIntoView({ block: 'nearest' });
  };

  const choose = (entry: Entry) => {
    close();
    if (entry.url) window.open(entry.url, '_blank', 'noopener');
    else if (entry.app) openApp(entry.app, { select: entry.select });
  };

  const open = () => {
    if (!root.hidden) return;
    root.hidden = false;
    input.value = '';
    render();
    input.focus();
  };

  const close = () => {
    if (root.hidden) return;
    root.classList.add('is-closing');
    setTimeout(() => {
      root.hidden = true;
      root.classList.remove('is-closing');
    }, 140);
  };

  input.addEventListener('input', render);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (results.length) select((selected + (event.key === 'ArrowDown' ? 1 : -1) + results.length) % results.length);
    } else if (event.key === 'Enter' && results[selected]) {
      event.preventDefault();
      choose(results[selected]!);
    } else if (event.key === 'Escape') {
      event.preventDefault();
      close();
    }
  });
  root.querySelector('.spotlight-scrim')!.addEventListener('click', close);

  document.addEventListener('spotlight:open', open);
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      root.hidden ? open() : close();
    }
  });
</script>

<style is:global>
  .spotlight {
    position: fixed;
    inset: 0;
    z-index: 90;
  }

  .spotlight-scrim {
    position: absolute;
    inset: 0;
  }

  .spotlight-panel {
    position: absolute;
    top: 22vh;
    left: 50%;
    width: min(680px, calc(100vw - 24px));
    transform: translateX(-50%);
    animation: spotlight-in 0.28s var(--spring) both;
  }

  .spotlight.is-closing .spotlight-panel {
    animation: spotlight-out 0.14s ease-in both;
  }

  @keyframes spotlight-in {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(0.96);
    }
  }

  @keyframes spotlight-out {
    to {
      opacity: 0;
      transform: translateX(-50%) scale(0.98);
    }
  }

  .spotlight-field,
  .spotlight-results {
    color: var(--label);
    background: var(--popover-bg);
    -webkit-backdrop-filter: blur(50px) saturate(180%);
    backdrop-filter: blur(50px) saturate(180%);
    box-shadow:
      0 0 0 0.5px var(--window-ring),
      inset 0 0.5px 0 rgb(255 255 255 / 0.3),
      0 20px 50px -14px rgb(0 0 0 / 0.45);
  }

  .spotlight-field {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 20px;
    border-radius: 999px;
  }

  .spotlight-field svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--label-2);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .spotlight-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: 22px;
    color: var(--label);
    -webkit-appearance: none;
    appearance: none;
  }

  .spotlight-field input::-webkit-search-cancel-button {
    display: none;
  }

  .spotlight-field input::placeholder {
    color: var(--label-3);
  }

  .spotlight-results {
    max-height: min(440px, 52vh);
    margin-top: 10px;
    padding: 6px;
    border-radius: 22px;
    overflow-y: auto;
  }

  .spotlight:not(.has-query) .spotlight-results {
    display: none;
  }

  .spotlight-kind {
    padding: 8px 12px 3px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--label-3);
  }

  .spotlight-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 5px 10px;
    border-radius: 12px;
    cursor: default;
  }

  .spotlight-item[aria-selected='true'] {
    background: var(--accent);
    color: #fff;
  }

  .spotlight-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
  }

  .spotlight-icon img {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    object-fit: cover;
  }

  .spotlight-icon .app-art {
    width: 32px;
    height: 32px;
  }

  .spotlight-glyph {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: #fff;
    color: #1d1d1f;
    font-size: 17px;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12);
  }

  .spotlight-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .spotlight-text strong {
    font-size: 14px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spotlight-text span {
    font-size: 12px;
    opacity: 0.65;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spotlight-empty {
    padding: 18px;
    text-align: center;
    color: var(--label-3);
  }

  @media (max-width: 899px) {
    .spotlight-scrim {
      background: rgb(0 0 0 / 0.35);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
    }

    .spotlight-panel {
      top: calc(env(safe-area-inset-top) + 56px);
    }

    .spotlight-field {
      height: 48px;
    }

    .spotlight-field input {
      font-size: 18px;
    }
  }
</style>
