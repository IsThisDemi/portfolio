  tag: '<path d="M3.5 12.6V5a1.5 1.5 0 0 1 1.5-1.5h7.6l8 8a1.5 1.5 0 0 1 0 2.1l-7 7a1.5 1.5 0 0 1-2.1 0Z"/><circle cx="8.3" cy="8.3" r="1.3"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  compose:
    '<path d="M11 4.5H6.5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V13"/><path d="M17.8 3.7a1.7 1.7 0 0 1 2.5 2.5L12 14.5l-3.3.8.8-3.3Z"/>',
  send: '<path d="M21 3 10.2 13.8M21 3l-6.5 18-4.3-7.2L3 9.5Z"/>',
