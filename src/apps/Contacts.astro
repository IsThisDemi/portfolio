---
import { Image } from 'astro:assets';
import { profile } from '@/data/cv';
import AppFrame from '@/components/AppFrame.astro';
import Glyph from '@/components/Glyph.astro';

const github = profile.links.find((link) => link.label === 'GitHub')!;
const linkedin = profile.links.find((link) => link.label === 'LinkedIn')!;
const phone = profile.details.find((detail) => detail.label === 'Phone')!;
const location = profile.details.find((detail) => detail.label === 'Location')!;
const display = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

// A real vCard, so "Share" adds Riccardo to the visitor's own Contacts.
const [first, last] = [profile.firstName, profile.name.replace(`${profile.firstName} `, '')];
const vcard = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  `N:${last};${first};;;`,
  `FN:${profile.name}`,
  `TITLE:${profile.role}`,
  `EMAIL;TYPE=INTERNET:${profile.email}`,
  `TEL;TYPE=CELL:${phone.url!.replace('tel:', '')}`,
  `URL:${github.url}`,
  `URL:${linkedin.url}`,
  `ADR;TYPE=HOME:;;;Vicenza;;;Italy`,
  'END:VCARD',
].join('\r\n');
const vcardHref = `data:text/vcard;charset=utf-8,${encodeURIComponent(vcard)}`;

const fields = [
  { label: 'email', value: profile.email, url: `mailto:${profile.email}` },
  { label: 'mobile', value: phone.value, url: phone.url },
  { label: 'home page', value: display(github.url), url: github.url },
  { label: 'LinkedIn', value: display(linkedin.url), url: linkedin.url },
  { label: 'home', value: location.value },
];
---

<AppFrame id="contacts" name="Contacts" label={`${profile.name} — Contacts`}>
  <div class="main contact">
    <header class="toolbar" data-drag>
      <span class="toolbar-spacer"></span>
      <div class="tb-group">
        <a
          class="tb-button"
          href={vcardHref}
          download={`${profile.name}.vcf`}
          aria-label="Share contact card"
          title="Share contact card (.vcf)"
        >
          <Glyph name="share" />
        </a>
      </div>
    </header>

    <div class="pane contact-pane">
      <div class="poster">
        <Image
          class="poster-photo"
          src={profile.photo}
          alt={profile.name}
          width={280}
          height={280}
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="poster-name">{profile.name}</h1>
        <p class="poster-role">{profile.role} · {profile.subtitle}</p>

        <ul class="contact-actions">
          <li>
            <a href={`mailto:${profile.email}`}><span><Glyph name="mail" /></span>mail</a>
          </li>
          <li>
            <a href={phone.url}><span><Glyph name="phone" /></span>call</a>
          </li>
          <li>
            <a href={linkedin.url} target="_blank" rel="noopener noreferrer"
              ><span><Glyph name="person" /></span>linkedin</a
            >
          </li>
          <li>
            <a href={profile.cv.url} download={profile.cv.fileName}><span><Glyph name="doc" /></span>résumé</a>
          </li>
        </ul>
      </div>

      <div class="contact-card">
        {
          fields.map((field) => (
            <div class="contact-field">
              <span class="contact-label">{field.label}</span>
              {field.url ? (
                <a
                  href={field.url}
                  target={field.url.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                >
                  {field.value}
                </a>
              ) : (
                <span>{field.value}</span>
              )}
            </div>
          ))
        }
      </div>

      <div class="contact-card">
        <div class="contact-field">
          <span class="contact-label">note</span>
          <p>{profile.about}</p>
          <p class="contact-note-status">{profile.status.join(' · ')}.</p>
        </div>
      </div>
    </div>
  </div>
</AppFrame>

<style>
  .contact {
    /* The poster color is taken from the photo: park greens and a dark jacket. */
    --poster-a: #6f8a73;
    --poster-b: #3d5245;
    background: linear-gradient(180deg, var(--poster-a), var(--poster-b));
    color: #fff;
  }

  :global(.app-contacts) {
    --tint: #fff;
    background: #3d5245;
  }

  .contact .tb-group {
    background: rgb(255 255 255 / 0.16);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.22);
  }

  .contact .tb-button {
    color: rgb(255 255 255 / 0.9);
  }

  .contact .tb-button:hover {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .contact-pane {
    padding: 0 22px 22px;
  }

  .poster {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 0 20px;
  }

  .poster-photo {
    width: 136px;
    height: 136px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 4px rgb(255 255 255 / 0.18),
      0 14px 34px -12px rgb(0 0 0 / 0.5);
  }

  .poster-name {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .poster-role {
    margin-top: 6px;
    font-size: 13px;
    color: rgb(255 255 255 / 0.75);
  }

  .contact-actions {
    display: flex;
    gap: 14px;
    margin-top: 18px;
  }

  .contact-actions a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: rgb(255 255 255 / 0.85);
  }

  .contact-actions span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.17);
    box-shadow:
      inset 0 0.5px 0 rgb(255 255 255 / 0.35),
      inset 0 0 0 0.5px rgb(255 255 255 / 0.12);
    transition:
      background-color 0.15s,
      transform 0.3s var(--spring);
  }

  .contact-actions a:hover span {
    background: rgb(255 255 255 / 0.26);
  }

  .contact-actions a:active span {
    transform: scale(0.92);
  }

  .contact-actions :global(.glyph) {
    width: 20px;
    height: 20px;
  }

  .contact-card {
    margin-top: 10px;
    border-radius: 16px;
    background: rgb(0 0 0 / 0.16);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.1);
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 9px 14px 10px;
    font-size: 14px;
  }

  .contact-field + .contact-field {
    box-shadow:
      inset 14px 0.5px 0 rgb(0 0 0 / 0),
      inset 0 0.5px 0 rgb(255 255 255 / 0.12);
  }

  .contact-label {
    font-size: 12px;
    color: rgb(255 255 255 / 0.62);
  }

  .contact-field a {
    color: #fff;
    overflow-wrap: anywhere;
  }

  .contact-field a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact-field p {
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }

  .contact-note-status {
    margin-top: 8px !important;
    color: #c9f7d4 !important;
  }

  @media (max-width: 899px) {
    .contact .toolbar {
      padding-top: 4px;
    }

    .contact-pane {
      padding: 0 16px calc(40px + env(safe-area-inset-bottom));
    }

    .poster-photo {
      width: 150px;
      height: 150px;
    }

    .poster-name {
      font-size: 32px;
    }

    .contact-actions {
      gap: 18px;
    }

    .contact-actions span {
      width: 52px;
      height: 52px;
    }

    .contact-field {
      font-size: 16px;
    }
  }
</style>
