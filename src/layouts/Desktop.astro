---
import { meta } from '@/data/cv';
import DesktopIcons from '@/components/DesktopIcons.astro';
import Dock from '@/components/Dock.astro';
import HomeScreen from '@/components/HomeScreen.astro';
import IconSprite from '@/components/IconSprite.astro';
import MenuBar from '@/components/MenuBar.astro';
import Spotlight from '@/components/Spotlight.astro';
import Wallpaper from '@/components/Wallpaper.astro';
import '@/styles/global.css';
import '@/styles/apps.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta name="theme-color" content="#0b1230" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Inter-roman.var.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply saved appearance before first paint (see src/scripts/prefs.ts).
      (function () {
        var root = document.documentElement;
        var get = function (key) {
          try {
            return localStorage.getItem(key);
          } catch (e) {
            return null;
          }
        };
        var theme = get('theme');
        // Dark by default, like the desktop it imitates; "auto" follows the system.
        var dark = theme === 'auto' ? matchMedia('(prefers-color-scheme: dark)').matches : theme !== 'light';
        root.classList.toggle('dark', dark);
        root.classList.add('js');
        root.dataset.accent = get('accent') || 'blue';
        root.dataset.wallpaper = get('wallpaper') || 'lake';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#0b1230' : '#d7ecff';
      })();
    </script>
  </head>
  <body>
    <IconSprite />
    <Wallpaper />
    <MenuBar />
    <main class="desktop">
      <DesktopIcons />
      <slot />
    </main>
    <HomeScreen />
    <Dock />
    <Spotlight />

    <script>
      import '@/scripts/shell';
      import { initLiquidGlass } from '@/scripts/liquid-glass';

      initLiquidGlass();
    </script>
  </body>
</html>

<style is:global>
  .js body {
    height: 100dvh;
    overflow: hidden;
  }

  .desktop {
    --dock-space: 92px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: calc(var(--menubar-h) + 20px) 20px 120px;
  }

  .js .desktop {
    position: fixed;
    inset: var(--menubar-h) 0 0;
    display: block;
    padding: 0;
  }

  /* On a phone the apps open above the home screen; the empty container must not eat taps. */
  @media (max-width: 899px) {
    .js .desktop {
      inset: 0;
      z-index: 80;
      pointer-events: none;
    }

    .js .desktop > .app,
    .js .desktop dialog {
      pointer-events: auto;
    }
  }

  .is-dragging,
  .is-dragging * {
    cursor: default !important;
    user-select: none !important;
  }

  .is-resizing,
  .is-resizing * {
    cursor: nwse-resize !important;
    user-select: none !important;
  }

  /* ── Notifications (src/scripts/notify.ts) ── */
  .notifications {
    position: fixed;
    top: calc(var(--menubar-h) + 8px);
    right: 10px;
    z-index: 95;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(350px, calc(100vw - 20px));
    pointer-events: none;
  }

  .notification {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 11px 14px;
    border-radius: 20px;
    color: var(--label);
    background: var(--popover-bg);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    backdrop-filter: blur(40px) saturate(180%);
    box-shadow:
      0 0 0 0.5px var(--window-ring),
      0 12px 30px -10px rgb(0 0 0 / 0.35);
    pointer-events: auto;
    cursor: default;
    animation: notification-in 0.5s var(--spring) both;
  }

  .notification.is-leaving {
    animation: notification-out 0.3s ease-in both;
  }

  @keyframes notification-in {
    from {
      opacity: 0;
      transform: translateX(110%);
    }
  }

  @keyframes notification-out {
    to {
      opacity: 0;
      transform: translateX(110%);
    }
  }

  .notification-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
  }

  .notification-icon svg {
    width: 19px;
    height: 19px;
  }

  .notification-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    font-size: 13px;
    line-height: 1.3;
  }

  .notification-text span {
    color: var(--label-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notification-time {
    align-self: flex-start;
    font-size: 11.5px;
    color: var(--label-3);
  }

  @media (max-width: 899px) {
    .notifications {
      top: calc(env(safe-area-inset-top) + 8px);
      left: 8px;
      right: 8px;
      width: auto;
    }

    .notification {
      border-radius: 24px;
    }
  }
</style>
