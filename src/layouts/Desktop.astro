---
import { meta } from '@/data/cv';
import Dock from '@/components/Dock.astro';
import IconSprite from '@/components/IconSprite.astro';
import MenuBar from '@/components/MenuBar.astro';
import Spotlight from '@/components/Spotlight.astro';
import Wallpaper from '@/components/Wallpaper.astro';
import '@/styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta name="theme-color" content="#0b1230" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Inter-roman.var.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply saved appearance before first paint (see src/scripts/prefs.ts).
      (function () {
        var root = document.documentElement;
        var get = function (key) {
          try {
            return localStorage.getItem(key);
          } catch (e) {
            return null;
          }
        };
        var theme = get('theme');
        // Dark by default, like the desktop it imitates; "auto" follows the system.
        var dark = theme === 'auto' ? matchMedia('(prefers-color-scheme: dark)').matches : theme !== 'light';
        root.classList.toggle('dark', dark);
        root.classList.add('js');
        root.dataset.accent = get('accent') || 'blue';
        root.dataset.wallpaper = get('wallpaper') || 'lake';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#0b1230' : '#d7ecff';
      })();
    </script>
  </head>
  <body>
    <IconSprite />
    <a class="skip-link" href="#about">Skip to content</a>
    <Wallpaper />
    <MenuBar />
    <main class="desktop">
      <slot />
    </main>
    <Dock />
    <Spotlight />

    <script>
      import '@/scripts/windows';
      import { initLiquidGlass } from '@/scripts/liquid-glass';

      initLiquidGlass();
    </script>
  </body>
</html>

<style is:global>
  .desktop {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    align-items: start;
    gap: 28px;
    width: 100%;
    max-width: 1220px;
    margin: 0 auto;
    padding: calc(var(--menubar-h) + 32px) 28px 140px;
  }

  .desktop > .window:not(.about-window, .terminal-window) {
    grid-column: 1 / -1;
  }

  .terminal-window {
    align-self: stretch;
    margin-top: 48px;
  }

  @media (max-width: 1023px) {
    .desktop {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      max-width: 720px;
      padding-inline: 20px;
    }

    .terminal-window {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .desktop {
      gap: 16px;
      padding: calc(var(--menubar-h) + env(safe-area-inset-top) + 18px) 10px calc(110px + env(safe-area-inset-bottom));
    }
  }

  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .theme-transition,
  .theme-transition * {
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      box-shadow 0.4s ease !important;
  }

  /* ── Notifications (src/scripts/notify.ts) ── */
  .notifications {
    position: fixed;
    top: calc(var(--menubar-h) + 10px);
    right: 12px;
    z-index: 95;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(350px, calc(100vw - 24px));
    pointer-events: none;
  }

  .notification {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 22px;
    pointer-events: auto;
    cursor: default;
    animation: notification-in 0.55s var(--spring) both;
  }

  .notification.is-leaving {
    animation: notification-out 0.3s ease-in both;
  }

  @keyframes notification-in {
    from {
      opacity: 0;
      transform: translateX(110%);
    }
  }

  @keyframes notification-out {
    to {
      opacity: 0;
      transform: translateX(110%);
    }
  }

  .notification-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .notification-icon svg {
    width: 20px;
    height: 20px;
  }

  .notification-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    line-height: 1.3;
    font-size: 13px;
  }

  .notification-text span {
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notification-time {
    align-self: flex-start;
    font-size: 11.5px;
    color: var(--text-3);
  }

  @media (max-width: 767px) {
    .notifications {
      top: calc(var(--menubar-h) + env(safe-area-inset-top) + 8px);
      left: 12px;
      right: 12px;
      width: auto;
    }
  }
</style>
